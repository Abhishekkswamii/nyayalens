# NyayaLens can authenticate to Gemini one of two ways. Set EITHER the
# direct Gemini API key block OR the Vertex AI block below — not both.

# --- Option A: direct Gemini API (simplest) ---
# Get a key at https://aistudio.google.com/apikey
# Server-side only — never exposed to the client.
GEMINI_API_KEY=

# --- Option B: Vertex AI (uses your Google Cloud project's billing/credits) ---
# Requires Application Default Credentials on the server (e.g. a service
# account key file referenced by GOOGLE_APPLICATION_CREDENTIALS, which must
# NEVER be committed to git).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=

# Model to use for document understanding, extraction, Q&A and comparison.
# Configurable so the app is not pinned to one model version. Note: the set
# of available model names can differ between the direct API and Vertex AI.
GEMINI_MODEL=gemini-2.5-flash
